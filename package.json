{
  "name": "human-health-os",
  "private": true,
  "version": "0.25.0",
  "description": "Human Health OS / Longevity App monorepo: one shared deterministic core powering the production client, the API and the Interactive Site Lab.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "verify:contracts": "python3 tools/verify_contracts.py",
    "verify": "pnpm typecheck && pnpm test && pnpm verify:contracts && pnpm build",
    "dev:site": "pnpm --filter @hhos/site dev",
    "dev:client": "pnpm --filter @hhos/client dev",
    "dev:api": "pnpm --filter @hhos/api dev",
    "e2e": "pnpm -r --if-present e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
